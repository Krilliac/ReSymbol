{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resymbol.dev/schemas/managed-host-bootstrap-v1.json",
  "title": "ReSymbol managed-host bootstrap",
  "description": "Host-owned first NDJSON line for one disposable managed plugin execution.",
  "$comment": "The encoded bootstrap is limited to 262144 UTF-8 bytes. x-resymbol-maxUtf8Bytes is a mandatory ReSymbol integration constraint for text fields because standard maxLength counts Unicode code points, not encoded bytes. entry_assembly must equal one normalized assemblies[].path; normalized assembly paths must be unique under ordinal case-insensitive comparison. PE header, section, and binary-size relationships are validated by the host because standard JSON Schema cannot express those cross-field invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "expected_artifact_sha256",
    "entry_assembly",
    "expected_plugin",
    "assemblies",
    "output_limits",
    "service_limits",
    "binary",
    "image"
  ],
  "properties": {
    "protocol": { "const": "resymbol.managed-host" },
    "expected_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "const": 0 }
      }
    },
    "entry_assembly": { "$ref": "#/$defs/relativeDll" },
    "expected_plugin": { "$ref": "#/$defs/expectedPlugin" },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativeDll" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "output_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_messages", "max_stdout_bytes"],
      "properties": {
        "max_messages": { "type": "integer", "minimum": 2, "maximum": 1000000 },
        "max_stdout_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8388608
        }
      }
    },
    "service_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_binary_read_bytes"],
      "properties": {
        "max_binary_read_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        }
      }
    },
    "binary": { "$ref": "#/$defs/binary" },
    "image": { "$ref": "#/$defs/peImage" },
    "deadline_unix_ms": {
      "type": ["integer", "null"],
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "relativeDll": {
      "type": "string",
      "minLength": 5,
      "pattern": "^(?![\\\\/])(?!.*[:<>\"|?*])(?!.*[\\u0000-\\u001F\\u007F-\\u009F])(?!(?:\\.{1,2}|[\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)(?:[\\\\/]|$))(?!.*[\\\\/](?:\\.{1,2}|[\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)(?:[\\\\/]|$))(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|[\\\\/]|$))(?!.*[\\\\/](?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|[\\\\/]|$))(?!.*[ .](?:[\\\\/]|$))(?![rR][eE][sS][yY][mM][bB][oO][lL]\\.[pP][lL][uU][gG][iI][nN][sS][dD][kK]\\.[dD][lL][lL]$)(?!.*[\\\\/][rR][eE][sS][yY][mM][bB][oO][lL]\\.[pP][lL][uU][gG][iI][nN][sS][dD][kK]\\.[dD][lL][lL]$)[^\\\\/]+(?:[\\\\/][^\\\\/]+)*\\.[dD][lL][lL]$"
    },
    "expectedPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "capabilities",
        "requested_permissions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
          "x-resymbol-maxUtf8Bytes": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
          "x-resymbol-maxUtf8Bytes": 128
        },
        "capabilities": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "requested_permissions": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "size", "format", "architecture"],
      "properties": {
        "id": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "format": { "const": "pe" },
        "architecture": { "const": "x86_64" },
        "image_base": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "default": 0
        }
      }
    },
    "peImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_of_headers", "size_of_image", "sections"],
      "properties": {
        "size_of_headers": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "size_of_image": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "sections": {
          "type": "array",
          "maxItems": 96,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "virtual_address",
              "virtual_size",
              "raw_data_offset",
              "raw_data_size"
            ],
            "properties": {
              "virtual_address": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "virtual_size": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "raw_data_offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "raw_data_size": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
            }
          }
        }
      }
    }
  }
}
