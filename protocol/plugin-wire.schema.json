{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resymbol.dev/schemas/plugin-wire-v1.json",
  "title": "ReSymbol external-process plugin wire protocol",
  "description": "Newline-delimited JSON messages exchanged over stdin/stdout with an out-of-process plugin. Stdout is protocol-only; diagnostics belong on stderr. Plugins submit claims and never mutate canonical symbol state directly.",
  "$comment": "A process boundary protects ReSymbol from plugin crashes but is not, by itself, an operating-system sandbox. Hosts must require artifact-bound trust unless they can enforce the declared permissions. A plugin declaration cannot opt itself into the ReSymbol process.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/helloResult" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "protocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "const": 0 }
      }
    },
    "manifestIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_message_bytes", "max_memory_bytes", "request_timeout_ms"],
      "properties": {
        "max_message_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 18446744073709551615
        },
        "max_memory_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 18446744073709551615,
          "description": "Memory budget advertised to the plugin. It is enforceable only when the selected platform host provides a memory sandbox."
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "required"],
      "properties": {
        "mode": { "const": "process" },
        "required": { "const": true }
      }
    },
    "pluginDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "capabilities",
        "requested_permissions",
        "isolation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/manifestIdentifier" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/manifestIdentifier" }
        },
        "requested_permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/manifestIdentifier" }
        },
        "isolation": { "$ref": "#/$defs/isolation" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid-argument",
            "incompatible-api",
            "permission-denied",
            "unavailable",
            "cancelled",
            "resource-limit",
            "internal"
          ]
        },
        "message": { "type": "string" },
        "data": { "type": ["object", "array", "string", "number", "boolean", "null"] }
      }
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-z0-9._-]+$"
        },
        "description": { "type": "string", "minLength": 1 },
        "data": {}
      }
    },
    "symbolSubject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binary", "rva"],
          "properties": {
            "kind": { "const": "function" },
            "binary": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
            "rva": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "size": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binary", "rva"],
          "properties": {
            "kind": { "const": "global" },
            "binary": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
            "rva": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "size": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binary", "key"],
          "properties": {
            "kind": { "const": "type" },
            "binary": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "controlFlowTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rva"],
          "properties": {
            "kind": { "const": "function" },
            "rva": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "iat_rva"],
          "properties": {
            "kind": { "const": "import-iat" },
            "iat_rva": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        }
      ]
    },
    "stringEncoding": {
      "type": "string",
      "enum": ["ascii", "utf-16-le"]
    },
    "symbolAssertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "name" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "declaration"],
          "properties": {
            "kind": { "const": "function-prototype" },
            "declaration": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "size"],
          "properties": {
            "kind": { "const": "function-boundary" },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "function-entry" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "call_site_rva", "target"],
          "properties": {
            "kind": { "const": "direct-call" },
            "call_site_rva": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "target": { "$ref": "#/$defs/controlFlowTarget" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "thunk-target" },
            "target": { "$ref": "#/$defs/controlFlowTarget" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "encoding", "value"],
          "properties": {
            "kind": { "const": "string-literal" },
            "encoding": { "$ref": "#/$defs/stringEncoding" },
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]*$"
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["encoding"],
                "properties": { "encoding": { "const": "ascii" } }
              },
              "then": {
                "properties": {
                  "value": { "pattern": "^[\\x20-\\x7E]+$" }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "instruction_rva", "instruction_size", "target_rva"],
          "properties": {
            "kind": { "const": "data-reference" },
            "instruction_rva": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "instruction_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "target_rva": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "declaration"],
          "properties": {
            "kind": { "const": "type-definition" },
            "declaration": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "class_name"],
          "properties": {
            "kind": { "const": "class-membership" },
            "class_name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "comment" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "symbolClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "claim", "confidence", "evidence"],
      "properties": {
        "subject": { "$ref": "#/$defs/symbolSubject" },
        "claim": { "$ref": "#/$defs/symbolAssertion" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimEvidence" }
        }
      }
    },
    "logPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "message"],
      "properties": {
        "level": {
          "enum": ["trace", "debug", "info", "warn", "error"]
        },
        "message": { "type": "string" }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "kind",
        "session_id",
        "plugin_id",
        "granted_permissions",
        "limits",
        "isolation"
      ],
      "properties": {
        "protocol": { "const": "resymbol.plugin-wire" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "hello" },
        "session_id": { "type": "string", "minLength": 1 },
        "plugin_id": { "$ref": "#/$defs/manifestIdentifier" },
        "granted_permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/manifestIdentifier" }
        },
        "limits": { "$ref": "#/$defs/limits" },
        "isolation": { "$ref": "#/$defs/isolation" }
      }
    },
    "helloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "kind", "descriptor"],
      "properties": {
        "protocol": { "const": "resymbol.plugin-wire" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "hello-result" },
        "descriptor": { "$ref": "#/$defs/pluginDescriptor" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "kind", "direction", "id", "method", "payload"],
      "properties": {
        "protocol": { "const": "resymbol.plugin-wire" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "request" },
        "direction": { "const": "host-to-plugin" },
        "id": { "type": "string", "minLength": 1 },
        "method": {
          "enum": ["initialize", "analyze", "health", "shutdown"]
        },
        "payload": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "kind", "direction", "id", "ok"],
      "properties": {
        "protocol": { "const": "resymbol.plugin-wire" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "response" },
        "direction": { "const": "plugin-to-host" },
        "id": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } } },
          "then": { "required": ["result"], "not": { "required": ["error"] } },
          "else": { "required": ["error"], "not": { "required": ["result"] } }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "kind", "direction", "method", "payload"],
      "properties": {
        "protocol": { "const": "resymbol.plugin-wire" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "event" },
        "direction": { "const": "plugin-to-host" },
        "method": { "enum": ["log", "claim"] },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "log" } } },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/logPayload" }
            }
          },
          "else": {
            "properties": {
              "payload": { "$ref": "#/$defs/symbolClaim" }
            }
          }
        }
      ]
    }
  }
}
